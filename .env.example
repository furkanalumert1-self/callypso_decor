# ─────────────────────────────────────────────────────────────────────────────
#  Callypso Decor — .env.example. Copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you. Every key is
#  OPTIONAL — with none set, Callypso Decor runs in DEMO MODE with sample projects and
#  generated before/after room visuals.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── fal.ai — stages the room photo (FLUX Kontext: keeps walls/windows/doors) ──
#    Server-side secret: never prefix with NEXT_PUBLIC_.
# https://fal.ai/dashboard/keys
FAL_KEY=

# ── Anthropic — Claude lists the room's fixed architecture before staging so ──
#    the image model is told exactly what must not change. Optional; server-side.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only for organisation-level keys (created outside a workspace): the workspace ID
# from Console → Workspaces. Not needed for keys created inside a workspace.
ANTHROPIC_WORKSPACE_ID=

# ── Supabase — stores projects, rooms & saved looks (optional) ───────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# anon key or the newer publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Shopify — import a furniture firm's products into the catalogue ──────────
# Shopify admin → Settings → Apps → Develop apps → create app → Admin API
# scope: read_products → install → copy the Admin API access token.
# Server-side secrets: never prefix with NEXT_PUBLIC_.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2026-07
