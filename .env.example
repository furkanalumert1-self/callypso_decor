# ─────────────────────────────────────────────────────────────────────────────
#  Callypso Decor — .env.example. Copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you. Every key is
#  OPTIONAL — with none set, Callypso Decor runs in DEMO MODE with sample projects and
#  generated before/after room visuals.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── fal.ai — generates the restyled / renovated before-after room visuals ─────
# https://fal.ai/dashboard/keys
FAL_KEY=

# ── Anthropic — style guidance, room descriptions & shopping suggestions ──────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Supabase — stores projects, rooms & saved looks (optional) ───────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
